  +execute(username: String, collection: Collection<StudyGroup>, group: StudyGroup): String
}

class AscendCommand {
  +AscendCommand()
  +execute(username: String, collection: Collection<StudyGroup>, empty: Void): List<StudyGroup>
}

class ClearCommand {
  +ClearCommand()
  +execute(username: String, collection: Collection<StudyGroup>, empty: Void): String
}

abstract class Command {
  +name: String
  ~{static} errorMessage: String = "Неверный ввод. Пожалуйста, повторите попытку"
  --
  +execute(username: String, collection: Collection<StudyGroup>, payload: In): Out
}

class FilterCommand {
  +FilterCommand()
  +execute(username: String, collection: Collection<StudyGroup>, name: String): List<StudyGroup>
}

class HelpCommand {
  +HelpCommand()
  +execute(username: String, collection: Collection<StudyGroup>, empty: Void): String
}

class HistoryCommand {
  +HistoryCommand()
  +execute(username: String, collection: Collection<StudyGroup>, history: Deque<String>): String
}

class InfoCommand {
  +InfoCommand()
  +execute(username: String, collection: Collection<StudyGroup>, empty: Void): String
}

class MaxSemCommand {
  +MaxSemCommand()
  +execute(username: String, collection: Collection<StudyGroup>, empty: Void): String
}

class RemoveCommand {
  +RemoveCommand()
  +execute(username: String, collection: Collection<StudyGroup>, id: Long): String
}

class RemoveLowerCommand {
  +RemoveLowerCommand()
  +execute(username: String, collection: Collection<StudyGroup>, group: StudyGroup): String
}

class ShowCommand {
  +ShowCommand()
  +execute(username: String, collection: Collection<StudyGroup>, empty: Void): List<StudyGroup>
}

class UpdateCommand {
  +UpdateCommand()
  +execute(username: String, collection: Collection<StudyGroup>, upd: UpdateRequest): String
}

interface Wrap {
  ~value(): Object
}

class Coordinates {
  -x: Long
  -y: long
  --
  +Coordinates(x: Long, y: long)
  +getX(): Long
  +getY(): long
  +toString(): String
}

class GroupBuilder {
  -group: StudyGroup = new StudyGroup()
  --
  +fromCSVString(csv: String, delimiter: String): GroupBuilder
  +setName(name: String): GroupBuilder
  +setCoords(coords: String): GroupBuilder
  +setAuthor(author: String): GroupBuilder
  +setStudentsCount(studentsCount: String): GroupBuilder
  +setTransferredStudents(transferredStudents: String): GroupBuilder
  +setAverageMark(averageMark: String): GroupBuilder
  +setSemesterEnum(semesterEnum: String): GroupBuilder
  +setGroupAdmin(groupAdmin: String): GroupBuilder
  +build(): StudyGroup
  +buildLoaded(): StudyGroup
}

interface NamedEnum {
  +getName(): String
  +{static} getByName(enumClass: Class<T>, name: String): T
  +{static} getStringItems(enumClass: Class<T>): String
}

class Person {
  -name: String
  -height: int
  -passportID: String
  -hairColor: Color
  --
  ~Person(name: String, height: int, passportID: String, hairColor: Color)
  +getName(): String
  +getHeight(): int
  +getPassportID(): String
  +getHairColor(): Color
  +toString(): String
}

interface Sendable {
}

class StudyGroup {
  -id: Long
  -name: String
  -authorName: String
  -coordinates: Coordinates
  -creationDate: LocalDateTime
  -studentsCount: Long
  -transferredStudents: int
  -averageMark: Integer
  -semesterEnum: Semester
  -groupAdmin: Person
  -{static} SETTERS: EnumMap<GroupParams, BiConsumer<StudyGroup, String>> = new EnumMap<>(GroupParams.class)
  +{static} DELIMITER: String = "\n"
  --
  +compareTo(other: StudyGroup): int
  +hashCode(): int
  +equals(o: Object): boolean
  -{static} valueOf(val: String, numbClass: Class<T>, variableName: String): T
  ~setID(id: Long): void
  ~setCreationDate(creationDate: java.time.LocalDateTime): void
  ~setName(newName: String): void
  +setAuthor(newName: String): void
  ~setCoords(newCoords: String): void
  ~setCount(studentsCount: String): void
  ~setTransferred(transferredStudents: String): void
  ~setAverage(averageMark: String): void
  ~setSemester(semester: String): void
  ~setPerson(persDesription: String): void
  +toCSVString(delimiter: String): String
  +toString(): String
  +{static} getSerializedSize(obj: StudyGroup): long
  +value(): StudyGroup
  +getId(): Long
  +getCreationDate(): LocalDateTime
  +getName(): String
  +getAuthorName(): String
  +getSemesterEnum(): Semester
  +getCoordinates(): Coordinates
  +getStudentsCount(): Long
  +getTransferredStudents(): int
  +getAverageMark(): Integer
  +getGroupAdmin(): Person
  +edit(prop: GroupParams, val: String): void
}

class DBCollection {
  -groups: ConcurrentSkipListSet<StudyGroup>
  -dbManager: DBManager
  --
  +DBCollection(dbManager: DBManager)
  +iterator(): Iterator<StudyGroup>
  +size(): int
  +add(group: StudyGroup): boolean
  +addLoaded(group: StudyGroup): boolean
  +remove(o: StudyGroup, username: String): boolean
  +update(o: StudyGroup, param: GroupParams, value: String, username: String): boolean
  +clear(username: String): boolean
}

class DBManager {
  -{static} DB_CFG_PATH: Path = Path.of("db.cfg")
  -collection: DBCollection
  -config: Properties
  --
  +DBManager()
  +getCollection(): DBCollection
  +getConnection(): Connection
  +initSchema(): void
  +addUser(login: String, password: String): UserData
  +authOrCreateUser(login: String, password: String): UserData
  +findUser(login: String): UserData
  +authUser(login: String, password: String): UserData
  +loadStudyGroups(): DBCollection
  +addStudyGroup(group: StudyGroup, ownerId: int): void
  +persistAddStudyGroup(group: StudyGroup): void
  +getStudyGroupByName(name: String): StudyGroup
  +getStudyGroupById(id: long): StudyGroup
  +persistRemoveStudyGroup(groupId: long, username: String): boolean
  +persistClearStudyGroups(username: String): boolean
  +persistUpdateStudyGroup(groupId: long, param: GroupParams, value: String, username: String): boolean
  -loadConfig(): Properties
  -requireConfig(key: String): String
}

class GroupHandler {
  ~{static} addStudyGroup(conn: Connection, group: StudyGroup, ownerId: int): void
  ~{static} getStudyGroupByName(conn: Connection, name: String): StudyGroup
  ~getStudyGroupById(conn: Connection, id: long): StudyGroup
  ~{static} persistAddStudyGroup(conn: Connection, group: StudyGroup): void
  -{static} studyGroupNameExists(conn: Connection, name: String): boolean
  ~{static} persistRemoveStudyGroup(conn: Connection, groupId: long, username: String): boolean
  ~{static} persistClearStudyGroups(conn: Connection, username: String): boolean
  ~{static} persistUpdateStudyGroup(conn: Connection, groupId: long, param: GroupParams, value: String, username: String): boolean
  ~{static} removeStudyGroup(conn: Connection, groupId: long, ownerId: int): boolean
  ~{static} clearUserStudyGroups(conn: Connection, ownerId: int): boolean
  ~{static} toCsvLine(rs: ResultSet): String
}

class UserHandler {
  ~{static} addUser(conn: Connection, login: String, password: String): UserData
  ~{static} authOrCreateUser(conn: Connection, login: String, password: String): UserData
  ~{static} findUser(conn: Connection, login: String): UserData
  ~{static} authUser(conn: Connection, login: String, password: String): UserData
}

class ReqReader {
  -{static} deserialize(data: byte[]): Object
  +{static} parse(payload: byte[]): CommandMessage
}

class RespSender {
  +{static} serialize(content: Serializable): byte[]
}

class ServerConnector {
  -{static} LENGTH_BYTES: int = Integer.BYTES
  -{static} MAX_MESSAGE_BYTES: int = 16 * 1024 * 1024
  -port: int
  -selector: Selector
  -serverChannel: ServerSocketChannel
  -payloadQueue: Queue<IncomingRequest> = new ConcurrentLinkedDeque<>()
  -selectorTasks: Queue<Runnable> = new ConcurrentLinkedDeque<>()
  --
  ~ServerConnector(port: int)
  +pump(timeoutMs: long): void
  +pollRequest(): IncomingRequest
  +getQueueRunnable(client: SocketChannel, payload: byte[]): Runnable
  -queueResponse(client: SocketChannel, payload: byte[]): void
  -queueResponseOnSelector(client: SocketChannel, payload: byte[]): void
  -runSelectorTasks(): void
  -accept(): void
  -read(key: SelectionKey): void
  -write(key: SelectionKey): void
  -closeClient(key: SelectionKey, reason: String): void
}

class ClientState {
  ~lengthBuffer: ByteBuffer = ByteBuffer.allocate(LENGTH_BYTES)
  ~dataBuffer: ByteBuffer
  ~pendingWrites: Queue<ByteBuffer> = new ArrayDeque<>()
}

class ServerHandler {
  ~{static} ENV_VAR: String = "GROUPS_FILE"
  ~{static} CSV_DELIMITER: String = ";"
  ~{static} commandsMap: Map<String, Command<?, ?>> = Map.copyOf(listCommands())
  ~{static} groupSet: DBCollection
  ~{static} dbManager: DBManager
  ~{static} history: Deque<String> = new ArrayDeque<>()
  --
  +ServerHandler()
  -{static} loadCollection(): DBCollection
  +{static} listCommands(): HashMap<String,Command<?,?>>
  ~run(request: CommandMessage): Object
  ~runConsole(consoleInput: String, status: boolean[]): String
  -executeCommand(userLogin: String, command: Command<?,?>, payload: Object): Object
}

class ServerLogger {
  -{static} LOGGER: Logger = LogManager.getLogger(ServerLogger.class)
  --
  +{static} log(line: String): void
}

class ServerMain {
  -{static} PORT: int = 4000
  -{static} SELECT_TIMEOUT_MS: long = 200
  -{static} READ_POOL_SIZE: int = 4
  -{static} PROCESS_POOL_SIZE: int = 8
  -{static} handler: ServerHandler = new ServerHandler()
  -{static} running: AtomicBoolean = new AtomicBoolean(true)
  -{static} consoleStatus: boolean = new boolean[] { true }
  -{static} readPool: ExecutorService = Executors.newFixedThreadPool(READ_POOL_SIZE)
  -{static} processPool: ExecutorService = Executors.newFixedThreadPool(PROCESS_POOL_SIZE)
  --
  +{static} main(args: String[]): void
  -{static} processRequest(connect: ServerConnector, incoming: ServerConnector.IncomingRequest, request: CommandMessage): void
  -{static} shutdownPool(pool: ExecutorService, poolName: String): void
}

class CSVTools {
  +{static} escapeCSVField(field: String, delimiter: String): String
  +{static} addToStringBuilder(sb: StringBuilder, field: String, delimiter: String): StringBuilder
  +{static} parseCSVLine(line: String, delimiter: String): String[]
}

class HashTools {
  +{static} hashPassword(password: String): byte[]
}

ClientMain --> LoginManager
ClientMain --> IOHandler
ClientMain ..> PayloadMaker
ClientMain ..> TCPConnector
LoginManager ..> IOHandler
PayloadMaker --> IOHandler
PayloadMaker ..> StudyGroup
AddCommand --|> Command
AddCommand ..> StudyGroup
AddMinCommand --|> AddCommand
AddMinCommand ..> StudyGroup
AscendCommand --|> Command
ClearCommand --|> Command
FilterCommand --|> Command
HelpCommand --|> Command
HistoryCommand --|> Command
InfoCommand --|> Command
MaxSemCommand --|> Command
RemoveCommand --|> Command
RemoveLowerCommand --|> Command
RemoveLowerCommand ..> StudyGroup
ShowCommand --|> Command
UpdateCommand --|> Command
Wrap --|> Sendable
GroupBuilder *-- StudyGroup
StudyGroup ..|> Sendable
StudyGroup *-- Coordinates
StudyGroup *-- Person
DBCollection o-- StudyGroup
DBCollection *-- DBManager
DBManager *-- DBCollection
DBManager ..> StudyGroup
GroupHandler ..> StudyGroup
GroupHandler ..> Coordinates
GroupHandler ..> Person
ServerHandler o-- Command
ServerHandler o-- DBCollection
ServerHandler --> DBManager
ServerMain *-- ServerHandler
ServerMain ..> ServerConnector
